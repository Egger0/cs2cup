# Direct connection is for local Next.js/standalone only. Cloudflare production
# receives a generated URL from the CS2CUP_DATABASE Hyperdrive binding.
DATABASE_URL=postgresql://postgres:dev@127.0.0.1:55432/cs2cup

# Unpadded base64url encoding of exactly 32 random bytes. It peppers local
# administrator password verifiers and login-throttle fingerprints.
ADMIN_AUTH_PEPPER=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# local | r2
PHOTO_UPLOAD_DRIVER=local
PHOTO_LOCAL_ROOT=

HOME_PREVIEW_COUNTDOWN=
REGISTRATION_FINGERPRINT_SECRET=
REGISTRATION_CLIENT_IP_SOURCE=

# Wrangler local Hyperdrive development can inject this outside the file:
# CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_CS2CUP_DATABASE=postgresql://...
