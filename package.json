{
  "name": "cs2cup",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "predev": "node scripts/generate-static-images.mjs",
    "dev": "npm run db:local:migrate && next dev",
    "prebuild": "node scripts/generate-static-images.mjs",
    "build": "next build --webpack",
    "cf:build": "opennextjs-cloudflare build",
    "cf:release": "npm run cf:build && npm run cf:size",
    "cf:build:local": "opennextjs-cloudflare build --config wrangler.local.jsonc",
    "cf:size": "node scripts/worker-size-test.mjs",
    "deploy": "node scripts/workers-deploy.mjs",
    "db:local:migrate": "node scripts/local-database.mjs migrate",
    "db:local:seed": "node scripts/local-database.mjs seed",
    "db:local:reset": "node scripts/local-database.mjs reset",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test:seeding": "node --experimental-strip-types scripts/seeding-test.mjs",
    "test:schedule": "node --experimental-strip-types scripts/schedule-test.mjs",
    "test:icalendar": "node --experimental-strip-types scripts/icalendar-test.mjs && node --experimental-strip-types scripts/tournament-calendar-test.mjs",
    "test:score-correction": "node --experimental-strip-types scripts/score-correction-test.mjs",
    "test:tournament-form": "node --experimental-strip-types scripts/tournament-form-test.mjs",
    "test:home-tournament-signal": "node --experimental-strip-types scripts/home-tournament-signal-test.mjs",
    "test:csv": "node --experimental-strip-types scripts/csv-test.mjs",
    "test:team-check-in": "node --experimental-strip-types scripts/team-check-in-test.mjs",
    "test:team-csv-route": "node --experimental-strip-types scripts/team-csv-route-test.mjs",
    "test:cloudflare-d1": "node scripts/cloudflare-d1-schema-test.mjs",
    "test:unified-identity-schema": "node scripts/unified-identity-schema-test.mjs",
    "test:identity-services": "node scripts/identity-service-suite.mjs",
    "test:local-seed": "node scripts/local-seed-test.mjs",
    "test:loopback": "node scripts/loopback-url-test.mjs",
    "test:rdb-filter": "node --experimental-strip-types scripts/rdb-filter-test.mjs",
    "test:image-upload": "node --experimental-strip-types scripts/image-upload-test.mjs",
    "test:csrf": "node --conditions=react-server --experimental-strip-types scripts/csrf-test.mjs",
    "test:admin-login": "node --conditions=react-server --experimental-strip-types scripts/admin-login-http-test.mjs && node --conditions=react-server --experimental-strip-types scripts/admin-login-query-test.mjs",
    "test:authorization": "node --conditions=react-server --experimental-strip-types scripts/admin-authorization-test.mjs",
    "test:admin-auth-wiring": "node --conditions=react-server --experimental-strip-types scripts/admin-auth-wiring-test.mjs",
    "test:admin-ui": "node scripts/admin-ui-wiring-test.mjs",
    "test:legacy-session-containment": "node --conditions=react-server --experimental-strip-types scripts/legacy-session-containment-test.mjs && node --conditions=react-server --experimental-strip-types scripts/legacy-opposite-session-test.mjs",
    "test:staff-check-in": "node --conditions=react-server --experimental-strip-types scripts/tournament-staff-session-test.mjs && node --conditions=react-server --experimental-strip-types scripts/staff-check-in-query-test.mjs",
    "test:tournament-staff-management": "node --conditions=react-server --experimental-strip-types scripts/tournament-staff-management-test.mjs",
    "test:registration": "node --experimental-strip-types scripts/registration-test.mjs",
    "test:registration-fingerprint": "node --experimental-strip-types scripts/registration-fingerprint-test.mjs",
    "test:registration-access": "node --experimental-strip-types scripts/registration-access-test.mjs",
    "test:registration-management": "node --experimental-strip-types scripts/registration-management-test.mjs",
    "test:participant-identity-schema": "node scripts/participant-identity-schema-test.mjs",
    "test:participant-identity": "node --conditions=react-server --experimental-strip-types scripts/participant-identity-test.mjs",
    "test:participant-account": "node --conditions=react-server --experimental-strip-types scripts/participant-account-test.mjs",
    "test:participant-entry-attachment": "node --conditions=react-server --experimental-strip-types scripts/participant-entry-attachment-test.mjs",
    "test:participant-owner-recovery": "node --experimental-strip-types scripts/participant-owner-recovery-test.mjs",
    "test:participant-next-match": "node --conditions=react-server --experimental-strip-types scripts/participant-next-match-test.mjs",
    "test:participant-return": "node --experimental-strip-types scripts/participant-return-test.mjs",
    "test:passkey-claim-recovery": "node --experimental-strip-types scripts/passkey-claim-recovery-test.mjs",
    "test:passkey-claim-verification": "node --conditions=react-server --experimental-strip-types scripts/passkey-claim-verification-test.mjs",
    "test:passkey-login-recovery": "node --experimental-strip-types scripts/passkey-login-recovery-test.mjs",
    "test:participant-passkey-schema": "node scripts/participant-passkey-schema-test.mjs",
    "test:participant-passkey": "node --conditions=react-server --experimental-strip-types scripts/participant-passkey-options-test.mjs && node --conditions=react-server --experimental-strip-types scripts/participant-passkey-query-test.mjs && node --conditions=react-server --experimental-strip-types scripts/participant-passkey-retention-test.mjs && node --conditions=react-server --experimental-strip-types scripts/passkey-http-test.mjs",
    "test:webauthn-config": "node --experimental-strip-types scripts/webauthn-config-test.mjs",
    "test:object-cleanup": "node --experimental-strip-types scripts/object-cleanup-test.mjs",
    "test:site-config": "node --experimental-strip-types scripts/site-config-test.mjs",
    "test:qq-daily-check-in": "node --conditions=react-server --experimental-strip-types scripts/qq-daily-check-in-test.mjs",
    "test:qq-bot": "node --conditions=react-server --experimental-strip-types scripts/qq-bot-test.mjs",
    "test:repository-language": "node scripts/repository-language-test.mjs",
    "test:repository-safety": "node scripts/repository-safety-test.mjs",
    "test:source-size": "node scripts/source-size-test.mjs",
    "test": "npm run test:seeding && npm run test:schedule && npm run test:icalendar && npm run test:score-correction && npm run test:tournament-form && npm run test:home-tournament-signal && npm run test:csv && npm run test:team-check-in && npm run test:team-csv-route && npm run test:cloudflare-d1 && npm run test:unified-identity-schema && npm run test:identity-services && npm run test:participant-identity-schema && npm run test:participant-passkey-schema && npm run test:local-seed && npm run test:loopback && npm run test:rdb-filter && npm run test:image-upload && npm run test:csrf && npm run test:admin-login && npm run test:authorization && npm run test:admin-auth-wiring && npm run test:admin-ui && npm run test:legacy-session-containment && npm run test:staff-check-in && npm run test:tournament-staff-management && npm run test:object-cleanup && npm run test:registration && npm run test:registration-fingerprint && npm run test:registration-access && npm run test:registration-management && npm run test:participant-identity && npm run test:participant-account && npm run test:participant-entry-attachment && npm run test:participant-owner-recovery && npm run test:participant-next-match && npm run test:participant-return && npm run test:passkey-claim-recovery && npm run test:passkey-claim-verification && npm run test:passkey-login-recovery && npm run test:participant-passkey && npm run test:webauthn-config && npm run test:site-config && npm run test:qq-daily-check-in && npm run test:qq-bot && npm run test:repository-language && npm run test:repository-safety && npm run test:source-size",
    "a11y": "node scripts/a11y.mjs",
    "keyboard": "node scripts/keyboard.mjs",
    "perf": "node scripts/perf.mjs",
    "browser:smoke": "node scripts/browser-check.mjs --smoke",
    "browser:check": "node scripts/browser-check.mjs",
    "check": "npm run format:check && npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "@fontsource-variable/big-shoulders": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@opennextjs/cloudflare": "^1.20.4",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.3",
    "playwright": "^1.62.1",
    "prettier": "3.8.1",
    "sharp": "0.35.3",
    "typescript": "^6.0.3",
    "wrangler": "^4.127.0"
  }
}
