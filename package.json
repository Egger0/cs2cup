{
  "name": "cs2cup",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node .next/standalone/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "stack:up": "docker compose up -d --wait",
    "stack:down": "docker compose down -v",
    "photos:import": "node --experimental-strip-types scripts/migrate-photos.ts && docker compose exec -T db psql -U postgres -d cs2cup -q -f - < migration-output/004_photos.sql && cp -R migration-output/photos/. public/photos/",
    "stack:seed": "node scripts/seed.mjs",
    "e2e": "node scripts/e2e.mjs",
    "serve": "npm run build && node scripts/pack-standalone.mjs && npm start",
    "e2e:admin": "node scripts/admin-e2e.mjs",
    "a11y": "node scripts/a11y.mjs",
    "keyboard": "node scripts/keyboard.mjs",
    "perf": "node scripts/perf.mjs",
    "check": "npm run typecheck && npm run lint && npm run e2e && npm run e2e:admin && npm run a11y && npm run keyboard && npm run perf"
  },
  "dependencies": {
    "@cloudbase/js-sdk": "^3.8.2",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@types/node": "26.3.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "axe-core": "^4.13.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.3",
    "jose": "^6.2.10",
    "playwright": "^1.62.1",
    "typescript": "^6.0.3"
  }
}
