{
  "name": "cs2cup",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "stack:up": "docker compose up -d --wait",
    "stack:down": "docker compose down -v",
    "photos:import": "node --experimental-strip-types scripts/migrate-photos.ts && docker compose exec -T db psql -U postgres -d cs2cup -q -f - < migration-output/004_photos.sql && cp -R migration-output/photos/. public/photos/"
  },
  "dependencies": {
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "26.3.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "10.9.1",
    "eslint-config-next": "16.3.3",
    "typescript": "7.0.2"
  }
}
