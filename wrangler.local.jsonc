{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cs2cup-local-only",
  "main": "worker.ts",
  "compatibility_date": "2026-08-28",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "send_metrics": false,
  "triggers": {
    "crons": ["0 1 * * *"],
  },
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "http://localhost:3000",
    "REGISTRATION_CLIENT_IP_SOURCE": "x-real-ip",
    "REGISTRATION_FINGERPRINT_SECRET": "local-only-identity-root-do-not-use-in-production-2026",
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "run_worker_first": ["/photos", "/photos/*"],
  },
  "d1_databases": [
    {
      "binding": "CS2CUP_DB",
      "database_name": "cs2cup-local-db",
      "migrations_dir": "cloudflare/d1",
      "remote": false,
    },
  ],
  "r2_buckets": [
    {
      "binding": "CS2CUP_MEDIA",
      "bucket_name": "cs2cup-local-media",
      "remote": false,
    },
  ],
  "services": [
    {
      "binding": "IDENTITY_PASSWORD_RANGE",
      "service": "cs2cup-browser-check-password-range",
      "remote": false,
    },
  ],
}
