{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nbt",
  "main": ".open-next/worker.js",
  "workers_dev": false,
  "preview_urls": false,
  "keep_vars": true,
  "compatibility_date": "2026-08-28",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "PHOTO_UPLOAD_DRIVER": "r2",
    "REGISTRATION_CLIENT_IP_SOURCE": "cf-connecting-ip"
  },
  "secrets": {
    "required": [
      "CF_ACCESS_ISSUER",
      "CF_ACCESS_AUDIENCE",
      "REGISTRATION_FINGERPRINT_SECRET"
    ]
  },
  // @Egger0 replaces this marker with the Hyperdrive configuration created in
  // the target Cloudflare account before the first deployment.
  "hyperdrive": [
    {
      "binding": "CS2CUP_DATABASE",
      "id": "SET_BY_EGGER0_IN_TARGET_CLOUDFLARE_ACCOUNT"
    }
  ],
  "r2_buckets": [
    {
      "binding": "CS2CUP_MEDIA",
      "bucket_name": "cs2cup-preview-media"
    }
  ]
}
